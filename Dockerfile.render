FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# Render's monorepo root-directory field accepts ASCII paths only. Keep the
# published Chinese project folder intact and copy the FastAPI service from it.
COPY ["IC科研/backend/requirements.txt", "./requirements.txt"]
RUN pip install --no-cache-dir -r requirements.txt
COPY ["IC科研/backend/app", "./app"]

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
